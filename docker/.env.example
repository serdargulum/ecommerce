# docker compose bu dosyayı okuyabilmesi için docker/.env olarak kopyalayın:
#   cp .env.example .env
# Üretimde değerleri değiştirin; .env dosyası sürüm kontrolüne eklenmez.

# Veritabanı
POSTGRES_DB=ecommerce
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# JWT — en az 32 karakter olmalı, üretimde mutlaka değiştirin:
#   openssl rand -base64 48
JWT_KEY=dev-only-ecommerce-jwt-key-change-me-please-32
JWT_ISSUER=Ecommerce.Api
JWT_AUDIENCE=Ecommerce.Web

# Tarayıcıdan erişilen adresler
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080

# Ana makinede yayınlanacak portlar (3000/8080 doluysa değiştirin)
WEB_PORT=3000
API_PORT=8080
